# ==============================================================================
# FinSense — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to `.env` for local Docker Compose usage:
#   cp .env.example .env
#
# SECURITY RULE:
# Never commit real secrets to `.env` or `appsettings.json`.
# For local .NET development, use `dotnet user-secrets` or `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 16 Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=finsense_user
POSTGRES_PASSWORD=change_me_local_pg_password
POSTGRES_DB=finsense_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. MinIO (S3-Compatible Object Storage for Receipt Images)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=finsense_minio_admin
MINIO_ROOT_PASSWORD=change_me_local_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=finsense-receipts

# ------------------------------------------------------------------------------
# 3. Internal Service-to-Service Security (ASP.NET Core <-> Python FastAPI)
# ------------------------------------------------------------------------------
INTERNAL_API_KEY=change_me_to_a_32_byte_random_internal_key

# ------------------------------------------------------------------------------
# 4. Python Deterministic Financial & Local OCR Service Configuration
# ------------------------------------------------------------------------------
# 100% local, API-free deterministic financial coach + RapidOCR receipt parser.
# No external LLM or cloud vision API keys are required.
ENVIRONMENT=development
MAX_INPUT_CHARS=250
MAX_OUTPUT_CHARS=450

# ------------------------------------------------------------------------------
# 5. JWT Authentication Configuration (ASP.NET Core Web API)
# ------------------------------------------------------------------------------
JWT_ISSUER=https://api.finsense.local
JWT_AUDIENCE=https://app.finsense.local
JWT_SIGNING_KEY=change_me_to_at_least_32_characters_long_signing_key
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30
