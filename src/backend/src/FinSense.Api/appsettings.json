{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "SET_VIA_USER_SECRETS_OR_ENV_VAR"
  },
  "Jwt": {
    "Issuer": "https://finsense.app",
    "Audience": "https://finsense.app",
    "SigningKey": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "InternalApiKey": "dev-internal-secret-key",
    "TimeoutSeconds": 25,
    "DailyChatQuotaPerUser": 15,
    "DailyReceiptQuotaPerUser": 10
  },
  "Storage": {
    "EndpointUrl": "http://localhost:9000",
    "BucketName": "finsense-receipts",
    "AccessKey": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "SecretKey": "SET_VIA_USER_SECRETS_OR_ENV_VAR",
    "ForcePathStyle": true
  }
}
